# My-nutritionist — browser environment variables.
# Copy to .env.local (gitignored) and fill in. Leave both empty to run in Offline/Local mode:
# the app never crashes without Supabase; it keeps all data on this device instead.
#
# Local stack:  npx supabase status -o env   (use API_URL and PUBLISHABLE_KEY)
# Hosted:       Dashboard → Project Settings → API Keys (publishable key) and the Project URL.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Older projects without publishable keys may use the legacy anon JWT instead. It is read only when
# VITE_SUPABASE_PUBLISHABLE_KEY is not defined at all, so delete that line when you use this one:
# VITE_SUPABASE_ANON_KEY=

# WARNING: every VITE_* variable is inlined into the public JavaScript bundle.
# NEVER put a secret key (sb_secret_…), the legacy service_role key, the database password or
# FDC_API_KEY in any VITE_* variable. The app refuses secret/service-role keys and falls back to
# Offline/Local mode. Server-side secrets belong in Edge Function secrets:
#   npx supabase secrets set FDC_API_KEY=...
